        "status": "VARCHAR(50)"
      },
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "constructorId", "references": "constructors(constructorId)"}
      ]
    },
    {
      "name": "constructorStandings",
      "columns": {
        "constructorStandingsId": "INT PRIMARY KEY AUTO_INCREMENT",
        "raceId": "INT NOT NULL",
        "constructorId": "INT NOT NULL",
        "points": "DECIMAL(10,2) NOT NULL DEFAULT 0",
        "position": "INT",
        "positionText": "VARCHAR(10)",
        "wins": "INT NOT NULL DEFAULT 0"
      },
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "constructorId", "references": "constructors(constructorId)"}
      ]
    },
    {
      "name": "driverStandings",
      "columns": {
        "driverStandingsId": "INT PRIMARY KEY AUTO_INCREMENT",
        "raceId": "INT NOT NULL",
        "driverId": "INT NOT NULL",
        "points": "DECIMAL(10,2) NOT NULL DEFAULT 0",
        "position": "INT",
        "positionText": "VARCHAR(10)",
        "wins": "INT NOT NULL DEFAULT 0"
      },
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "driverId", "references": "drivers(driverId)"}
      ]
    },
    {
      "name": "qualifying",
      "columns": {
        "qualifyId": "INT PRIMARY KEY AUTO_INCREMENT",
        "raceId": "INT NOT NULL",
        "driverId": "INT NOT NULL",
        "constructorId": "INT NOT NULL",
        "number": "INT NOT NULL DEFAULT 0",
        "position": "INT",
        "q1": "VARCHAR(20)",
        "q2": "VARCHAR(20)",
        "q3": "VARCHAR(20)"
      },
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "driverId", "references": "drivers(driverId)"},
        {"column": "constructorId", "references": "constructors(constructorId)"}
      ]
    },
    {
      "name": "results",
      "columns": {
        "resultId": "INT PRIMARY KEY AUTO_INCREMENT",
