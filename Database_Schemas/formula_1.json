      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "driverId", "references": "drivers(driverId)"},
        {"column": "constructorId", "references": "constructors(constructorId)"},
        {"column": "statusId", "references": "status(statusId)"}
      ]
    },
    {
      "name": "lapTimes",
      "columns": {
        "raceId": "INT NOT NULL",
        "driverId": "INT NOT NULL",
        "lap": "INT NOT NULL",
        "position": "INT",
        "time": "VARCHAR(20)",
        "milliseconds": "INT"
      },
      "primary_key": ["raceId", "driverId", "lap"],
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "driverId", "references": "drivers(driverId)"}
      ]
    },
    {
      "name": "pitStops",
      "columns": {
        "raceId": "INT NOT NULL",
        "driverId": "INT NOT NULL",
        "stop": "INT NOT NULL",
        "lap": "INT NOT NULL",
        "time": "VARCHAR(20) NOT NULL",
        "duration": "VARCHAR(20)",
        "milliseconds": "INT"
      },
      "primary_key": ["raceId", "driverId", "stop"],
      "foreign_keys": [
        {"column": "raceId", "references": "races(raceId)"},
        {"column": "driverId", "references": "drivers(driverId)"}
      ]
    }
  ]
}
