{
  "database": "formula_1",
  "tables": [
    {
      "name": "seasons",
      "columns": {
        "year": "INT PRIMARY KEY",
        "url": "VARCHAR(255) NOT NULL UNIQUE"
      },
      "foreign_keys": []
    },
    {
      "name": "circuits",
      "columns": {
        "circuitId": "INT PRIMARY KEY AUTO_INCREMENT",
        "circuitRef": "VARCHAR(100) NOT NULL DEFAULT ''",
        "name": "VARCHAR(255) NOT NULL DEFAULT ''",
        "location": "VARCHAR(255)",
        "country": "VARCHAR(100)",
        "lat": "DECIMAL(10,6)",
        "lng": "DECIMAL(10,6)",
        "alt": "INT",
        "url": "VARCHAR(255) NOT NULL UNIQUE"
      },
      "foreign_keys": []
    },
    {
      "name": "constructors",
      "columns": {
        "constructorId": "INT PRIMARY KEY AUTO_INCREMENT",
        "constructorRef": "VARCHAR(100) NOT NULL DEFAULT ''",
        "name": "VARCHAR(255) NOT NULL UNIQUE",
        "nationality": "VARCHAR(100)",
        "url": "VARCHAR(255) NOT NULL"
      },
      "foreign_keys": []
    },
    {
      "name": "drivers",
      "columns": {
        "driverId": "INT PRIMARY KEY AUTO_INCREMENT",
        "driverRef": "VARCHAR(100) NOT NULL DEFAULT ''",
        "number": "INT",
        "code": "VARCHAR(10)",
        "forename": "VARCHAR(100) NOT NULL DEFAULT ''",
        "surname": "VARCHAR(100) NOT NULL DEFAULT ''",
        "dob": "DATE",
        "nationality": "VARCHAR(100)",
        "url": "VARCHAR(255) NOT NULL UNIQUE"
      },
      "foreign_keys": []
    },
    {
      "name": "status",
      "columns": {
        "statusId": "INT PRIMARY KEY AUTO_INCREMENT",
        "status": "VARCHAR(100) NOT NULL DEFAULT ''"
      },
      "foreign_keys": []
    },
    {
      "name": "races",
      "columns": {
        "raceId": "INT PRIMARY KEY AUTO_INCREMENT",
        "year": "INT NOT NULL",
        "round": "INT NOT NULL",
        "circuitId": "INT NOT NULL",
        "name": "VARCHAR(255) NOT NULL DEFAULT ''",
        "date": "DATE NOT NULL DEFAULT '0000-00-00'",
        "time": "VARCHAR(50)",
        "url": "VARCHAR(255) UNIQUE"
      },
      "foreign_keys": [
        {"column": "year", "references": "seasons(year)"},
        {"column": "circuitId", "references": "circuits(circuitId)"}
      ]
    },
    {
      "name": "constructorResults",
      "columns": {
        "constructorResultsId": "INT PRIMARY KEY AUTO_INCREMENT",
        "raceId": "INT NOT NULL",
