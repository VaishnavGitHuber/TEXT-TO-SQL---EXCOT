        "number": "INT",
        "grid": "INT NOT NULL DEFAULT 0",
        "position": "INT",
        "positionText": "VARCHAR(10) NOT NULL DEFAULT ''",
        "positionOrder": "INT NOT NULL DEFAULT 0",
        "points": "DECIMAL(10,2) NOT NULL DEFAULT 0",
        "laps": "INT NOT NULL DEFAULT 0",
        "time": "VARCHAR(50)",
        "milliseconds": "INT",
        "fastestLap": "INT",
